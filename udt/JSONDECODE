FUNCTION JSONDECODE(JSON, SPEC)
* MVX json package — portable (UniData/BASIC) JSONDECODE: decode JSON per a
* MAPFIELD spec into an @AM array, each value at its mapped attribute.  The
* native mvx JSONDECODE does the general case; this covers the common shapes:
*   - scalar fields (assoc empty): a flat "key":"value" in the object;
*   - one association: an array of flat objects under the assoc key, whose
*     members decode into PARALLEL multivalued attributes (R<pos> a @VM list,
*     R<pos,i> the i-th element's value).
* Just enough JSON for MVPKG (metadata + search); the MVX json extension does
* the general case.  Values are taken as the text between the first quote pair
* after the key (no escape handling — sufficient for the registry).  GPL-2.0-only.
   RESULT = ""
   DQ = CHAR(34)
   BS = CHAR(92)
   NF = DCOUNT(SPEC, @AM)

* --- scalar fields (assoc empty): flat "key":"value" ------------------------
   FOR FI = 1 TO NF
      IF FIELD(SPEC<FI>, @VM, 5) = "" THEN
         JKEY = FIELD(SPEC<FI>, @VM, 1)
         POS = FIELD(SPEC<FI>, @VM, 2)
         SRC = JSON ; GOSUB QVALUE
         RESULT<POS> = VAL
      END
   NEXT FI

* --- associations: an array of objects under the assoc key ------------------
* distinct assoc names, in spec order
   ASSOCS = ""
   FOR FI = 1 TO NF
      A = FIELD(SPEC<FI>, @VM, 5)
      IF A # "" THEN
         LOCATE(A, ASSOCS; DUMP) ELSE ASSOCS<-1> = A
      END
   NEXT FI

   FOR AI = 1 TO DCOUNT(ASSOCS, @AM)
      ASC = ASSOCS<AI>
      * the [ ... ] array that follows "asc"
      * lowercased for the same reason as QVALUE's TAG
      AP = INDEX(JSON, DQ : OCONV(ASC, "MCL") : DQ, 1)
      IF AP > 0 THEN
         TAIL = JSON[AP, LEN(JSON) - AP + 1]
         OB = INDEX(TAIL, "[", 1)
         CB = INDEX(TAIL, "]", 1)
         IF OB > 0 AND CB > OB THEN
            REST = TAIL[OB + 1, CB - OB - 1]
            EI = 0
            DONE = 0
            LOOP
               S1 = INDEX(REST, "{", 1)
               IF S1 = 0 THEN DONE = 1
            UNTIL DONE DO
               E1 = INDEX(REST, "}", 1)
               IF E1 = 0 THEN E1 = LEN(REST) + 1
               OBJ = REST[S1 + 1, E1 - S1 - 1]
               EI = EI + 1
               FOR FI = 1 TO NF
                  IF FIELD(SPEC<FI>, @VM, 5) = ASC THEN
                     JKEY = FIELD(SPEC<FI>, @VM, 1)
                     POS = FIELD(SPEC<FI>, @VM, 2)
                     SRC = OBJ ; GOSUB QVALUE
                     RESULT<POS, EI> = VAL
                  END
               NEXT FI
               REST = REST[E1 + 1, LEN(REST) - E1]
            REPEAT
         END
      END
   NEXT AI
   RETURN(RESULT)

* QVALUE: VAL = the value of "KEY":... in SRC (or "" if absent).
*
* NOT EVERY VALUE IS QUOTED.  This looked for the opening quote after the colon
* and read to the next one -- so a number went straight past its own value and
* returned the NEXT KEY'S NAME, and an escaped quote inside a string ended it
* early.  Both were there from the start and neither is platform-specific; a
* round-trip test found them, which is what a round-trip test is for.
*
*   "qty":42            -> 42, not "note"
*   "note":"He said \"hi\""  -> He said "hi"
QVALUE:
   * EVERY NAME HERE IS THE CALLER'S NAME.  A GOSUB shares the whole variable
   * space, and this is called from inside the association loop -- which counts
   * its members with DONE.  Using DONE as a local flag here ended that loop
   * after one member, silently, and the record came back with the first
   * multivalue only.  The Q prefix is not decoration.
   VAL = ""
   * THE ENCODER LOWERCASES EVERY KEY (JSONENCODE, EMITKEY: OCONV(NAME,"MCL")),
   * so a lookup that uses the spec's own casing finds nothing the moment a
   * spec key has a capital in it.  Fold it the same way, in the same place a
   * reader will look for the reason.
   TAG = DQ : OCONV(JKEY, "MCL") : DQ
   P = INDEX(SRC, TAG, 1)
   IF P > 0 THEN
      QAFTER = SRC[P + LEN(TAG), LEN(SRC)]
      C = INDEX(QAFTER, ":", 1)
      IF C > 0 THEN
         QAFTER = QAFTER[C + 1, LEN(QAFTER)]
         * skip the space a pretty-printer leaves after the colon
         LOOP WHILE QAFTER[1,1] = " " DO QAFTER = QAFTER[2, LEN(QAFTER)] REPEAT
         IF QAFTER[1,1] = DQ THEN
            * a string: read to the closing quote, and a quote that is escaped
            * is not the closing one.
            QAFTER = QAFTER[2, LEN(QAFTER)]
            I = 1 ; QDONE = 0
            LOOP WHILE QDONE = 0 AND I <= LEN(QAFTER) DO
               QCH = QAFTER[I,1]
               BEGIN CASE
                  CASE QCH = BS
                     * \" \\ \/ keep the second character; the rest of the
                     * escapes are the ones JSONENCODE emits by name.
                     QNX = QAFTER[I+1,1]
                     BEGIN CASE
                        CASE QNX = "n" ; VAL := CHAR(10)
                        CASE QNX = "t" ; VAL := CHAR(9)
                        CASE QNX = "r" ; VAL := CHAR(13)
                        CASE QNX = "b" ; VAL := CHAR(8)
                        CASE QNX = "f" ; VAL := CHAR(12)
                        CASE 1        ; VAL := QNX
                     END CASE
                     I += 2
                  CASE QCH = DQ
                     QDONE = 1
                  CASE 1
                     VAL := QCH ; I += 1
               END CASE
            REPEAT
         END ELSE
            * a number, true, false or null: it ends at the comma or the brace.
            E = LEN(QAFTER) + 1
            CM = INDEX(QAFTER, ",", 1) ; IF CM > 0 AND CM < E THEN E = CM
            CB2 = INDEX(QAFTER, "}", 1) ; IF CB2 > 0 AND CB2 < E THEN E = CB2
            CB3 = INDEX(QAFTER, "]", 1) ; IF CB3 > 0 AND CB3 < E THEN E = CB3
            VAL = TRIM(QAFTER[1, E - 1])
         END
      END
   END
   RETURN
